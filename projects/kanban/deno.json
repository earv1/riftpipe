{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview"
  },
  "imports": {
    "solid-js": "npm:solid-js@^1.9.3",
    "vite": "npm:vite@^6.0.7",
    "vite-plugin-solid": "npm:vite-plugin-solid@^2.11.0"
  },
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns"
    ]
  }
}
