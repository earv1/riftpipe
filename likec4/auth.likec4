// Planned auth model: centralized ISSUANCE (a provider vouches for who you are,
// touched once to get a capability) + decentralized OFFLINE VERIFICATION (peers
// check the capability locally, data stays P2P). Rendered by `npm run diagrams`
// and embedded in docs/planned/auth.md. NOT built yet.

// Element kinds (actor/system/component/artifact) are declared once, project-wide,
// in security.likec4 — LikeC4 treats all files here as one model.

model {
  enduser = actor 'User' {
    description 'Brings an identity they already have. Never registers a riftpipe account.'
  }

  issuance = system 'Control plane — issuance (touched once, to get a capability)' {
    nostr = component 'Nostr (NIP-07) — REQUIRED (interim)' {
      description 'The current identity: a self-sovereign secp256k1 key via a browser extension (window.nostr). Verified in-core, pure-Rust via k256. Mandatory until Google OIDC lands.'
    }
    passkey = component 'Passkey / WebAuthn — planned' {
      description 'No company, no setup, in every browser + OS. A device-held keypair verified in-core with pure-Rust p256/ed25519-dalek (ES256/EdDSA). Planned.'
    }
    google = component 'Google (OIDC + PKCE) — WIP' {
      description 'Work in progress. For real-account gating: public client_id (safe to commit), NO secret, NO server; ID token verified offline against Google JWKS.'
    }
    capability = artifact 'Capability (Biscuit)' {
      description 'Signed by a ROOT key. Binds a role (e.g. board:X writer) to the user identity keypair. Offline-verifiable, attenuable, delegatable.'
    }
  }

  meshplane = system 'Data plane — P2P (offline, never needs a provider)' {
    verify = component 'Offline capability verify' {
      description 'core (wasm + native) checks the Biscuit against the embedded ROOT public key. No server round-trip.'
    }
    signedwrites = component 'Signed writes' {
      description 'Each write signed by the identity keypair; peers accept only what the capability authorizes.'
    }
    sealedmesh = component 'Sealed mesh (shipped)' {
      description 'topic = H(secret), AEAD frames (SECURITY.md). Sync is P2P over iroh — no server in the data path.'
    }
  }

  enduser -> issuance.nostr 'brings a Nostr key (required now)'
  enduser -> issuance.passkey 'passkey (planned)'
  enduser -> issuance.google 'Google account (WIP)'
  issuance.nostr -> issuance.capability 'identity → sign a capability'
  issuance.passkey -> issuance.capability 'identity → sign a capability'
  issuance.google -> issuance.capability 'identity → sign a capability'
  issuance.capability -> meshplane.verify 'presented to peers'
  meshplane.verify -> meshplane.signedwrites 'gates'
  meshplane.signedwrites -> meshplane.sealedmesh 'ride the sealed mesh'
}

views {
  view auth_planes {
    title 'Auth (planned): centralized issuance, decentralized offline verification'
    include enduser, issuance, issuance.*, meshplane, meshplane.*
    autoLayout LeftRight
  }
}
