// The sharing / trust architecture. `sealed_today` = the shipped model (secret
// -> topic + AEAD, PROTOCOL_VERSION 2); `remaining` = the insider gap signing
// would close. Rendered into docs/diagrams/ by `npm run diagrams` and embedded
// in SECURITY.md.

specification {
  element actor {
    style {
      shape person
    }
  }
  element system
  element component
  element artifact {
    style {
      shape storage
    }
  }
}

model {
  holder = actor 'Link holder' {
    description 'Has the share URL — a bearer capability. Can read + write everything.'
  }
  stranger = actor 'Stranger' {
    description 'No link. May learn a host EndpointId (public key) from discovery infra.'
  }

  // ---- Shipped: sealed board (PROTOCOL_VERSION 2) ----
  sealed = system 'Board mesh — today (sealed)' {
    sharelink = artifact 'Share link' {
      description 'URL fragment = ticket: 32-byte SECRET + host address. Never sent to any server.'
    }
    topic = component 'Gossip topic' {
      description 'TopicId = H(secret) — underivable from public identity'
    }
    aead = component 'AEAD frame seal' {
      description 'Every MeshMsg sealed with KDF(secret) (XChaCha20-Poly1305). Relay + non-holders see only ciphertext.'
    }
    peers = component 'Peers' {
      description 'Browser (riftpipe-web) + CLI (riftpipe connect) — same topic, same key, same frames'
    }
  }

  relay = system 'n0 relay / discovery' {
    description 'Routes QUIC; sees connection metadata and (now) only sealed ciphertext'
  }

  holder -> sealed.sharelink 'possesses'
  sealed.sharelink -> sealed.topic 'topic = H(secret)'
  sealed.sharelink -> sealed.aead 'key = KDF(secret)'
  sealed.peers -> sealed.aead 'seal outgoing / open incoming'
  sealed.aead -> relay 'transits as ciphertext'
  stranger -> sealed.topic 'cannot derive the topic or the key — locked out'

  // ---- Remaining: authorship + read/write split (signing) ----
  remaining = system 'Board mesh — remaining (signing)' {
    insider = actor 'Malicious holder' {
      description 'Already has the link. Sealing does NOT stop them (they hold the key).'
    }
    forge = component 'Forgeable messages' {
      description 'Unsigned frames: forge Presence/Version, freeze a file (Lww version=u64::MAX), replace a doc via origin rule'
    }
    signed = component 'Signed ops (planned)' {
      description 'Per-message Ed25519 signature -> authorship provable; a read/write key split enables view-only links'
    }
    insider -> forge 'can still forge — one shared key, no authorship'
    signed -> forge 'closes'
  }
}

views {
  view sealed_today {
    title 'Today (shipped): secret-derived topic + sealed frames'
    include holder, stranger, sealed, sealed.*, relay
    autoLayout TopBottom
  }

  view remaining {
    title 'Remaining: signing closes the insider gap'
    include remaining, remaining.*
    autoLayout TopBottom
  }
}
